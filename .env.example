# ── OpenRouter ────────────────────────────────────────────────────────────────
# API key for all AI completions (https://openrouter.ai/keys).
# Default model: anthropic/claude-sonnet-4-6
OPENROUTER_API_KEY=sk-or-v1-...

# ── Supabase ──────────────────────────────────────────────────────────────────
# Project URL and anon key (browser-safe)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Service-role key (server-only — never expose to the browser)
SUPABASE_SERVICE_KEY=eyJhbGciOi...

# ── GitHub ────────────────────────────────────────────────────────────────────
# Fine-grained PAT scoped to your repo (contents + pull_requests + issues read/write).
# Server-only. Never logged or echoed to the client.
GITHUB_PAT=github_pat_...

# Which repo to use as the constitution source and for PR/issue management.
# Defaults to bayuewalker/walkermind-os if not set.
GITHUB_REPO_OWNER=yourusername
GITHUB_REPO_NAME=your-repo

# Legacy alias — still accepted if GITHUB_PAT is not set.
# GITHUB_PAT_CONSTITUTION=github_pat_...

# ── Site URL ──────────────────────────────────────────────────────────────────
# Used in OpenRouter attribution headers (HTTP-Referer).
# Set to your fly.io domain after deploy.
NEXT_PUBLIC_SITE_URL=https://warp-codx.fly.dev

# ── Optional / Admin ──────────────────────────────────────────────────────────
# Enable GET /api/debug/constitution-stats in production.
# DEBUG_CONSTITUTION_STATS=1

# Shared secret for /api/constitution/clear and /api/constitution/test-pat.
# WARP_ADMIN_TOKEN=changeme

# ── fly.io deployment ─────────────────────────────────────────────────────────
# After `fly launch`, set secrets with:
#
#   fly secrets set \
#     OPENROUTER_API_KEY="sk-or-v1-..." \
#     NEXT_PUBLIC_SUPABASE_URL="https://..." \
#     NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJ..." \
#     SUPABASE_SERVICE_KEY="eyJ..." \
#     GITHUB_PAT="github_pat_..." \
#     GITHUB_REPO_OWNER="yourusername" \
#     GITHUB_REPO_NAME="your-repo" \
#     NEXT_PUBLIC_SITE_URL="https://your-app.fly.dev"
#
# Then deploy:
#   fly deploy
